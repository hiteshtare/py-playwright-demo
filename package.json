{
  "name": "py-playwright-demo",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "allure:clear": "rm -r allure-results/** && cp -r allure-reports/history/ allure-results && rm -r allure-reports/**",
    "allure:report": "allure generate allure-results --name 'PlayWright_Demo' --clean -o allure-reports",
    "pretest:baseline": "rm -r screenshots/**",
    "test:baseline": "NODE_ENV=release npx playwright test",
    "pretest:compare": "npm run allure:clear",
    "test:compare": "NODE_ENV=staging npx playwright test || npm run posttest:compare",
    "posttest:compare": "npm run allure:report",
    "test:update-baseline": "NODE_ENV=release npx playwright test --update-snapshots"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hiteshtare/py-playwright-demo.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/hiteshtare/py-playwright-demo/issues"
  },
  "homepage": "https://github.com/hiteshtare/py-playwright-demo#readme",
  "devDependencies": {
    "@pixeleye/playwright": "^0.8.5",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "allure-playwright": "^3.4.2",
    "pixeleye": "^0.8.8",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "exec": "^0.2.1",
    "@pixeleye/playwright": "0.8.5",
    "playwright": "^1.44.1"
  }
}
